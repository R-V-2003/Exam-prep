# API Keys
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Serverless base API URL (useful for Android builds to communicate with Vercel API proxy routes)
# Example: VITE_API_BASE_URL=https://your-app.vercel.app
VITE_API_BASE_URL=

# Supabase (free) - https://supabase.com
# 1. Create free account → New Project
# 2. Settings → API → copy URL and anon key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

